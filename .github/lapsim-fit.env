# Settings of the car calibration (scripts/sim/calibrate.mjs), read by every calibration job of lapsim-data.yml (split run:
# f1-joint, f1-holdout, wec, merge), so all parts fit with the same settings. Script defaults = the published fit (5 rounds x 200
# steps, all four seasons); G1 2026-11-18: 3 x 100 raised the held-out error on all 34 poles (1.014 -> 1.205 %, Gate G reject).
# A6 (owner 2026-11-17): FIA zones + 2026 PU qualifying curve (experiment run 43775148422, variant zq: all 1.235 -> 1.144 %,
# WEC 1.432 -> 1.210 %, F1 1.008 -> 1.075 %; the owner accepts the F1 cost of following the real 2026 PU rules)
LAPSIM_FIA_ZONES=on
LAPSIM_PU_QUALI=on
# C5.12 power-reduction ramp in the fit (run 44886079566, Gate G v2 correctness, m = 2, k = 1.45): F1 1.070 -> 0.983 %, RMS loss
# bound 0.019 <= 0.054 (pass). WEC moved only through the shared F1 track grip, which is frozen for WEC since #381
LAPSIM_PU_RAMP=on
# Hypercar (LMH/LMDh) peak braking capped at the iRacing GTP envelope 8.63 + 0.003234 v^2 m/s^2 (owner rule 14: learned from
# iRacing, "model"). Experiment 44043761033: hypercar holdout mean 1.24 -> 1.16 % (BE0 -> BE1; 1.15x envelope BE2: 1.20 %)
LAPSIM_BRAKE_ENV_HYPER=8.63,0.003234
# broken stretches in the OpenF1 traces are not measured data (AGENTS.md): dropped before the fit. Run 45025282535 vs base
# 44982191480 (same build): F1 lap RMS 0.920 -> 0.920 %, level C 2.704 -> 2.675 %, WEC 1.299 unchanged; 594 samples dropped
LAPSIM_TRACE_MASK=1
